[Unit]
Description=Hadoop NodeManager
After=network.target

[Service]
Type=simple
User={{ hadoop_user }}
Environment="JAVA_HOME={{ java_home }}"
Environment="HADOOP_CONF_DIR={{ hadoop_dist }}/etc/hadoop"
ExecStart={{ hadoop_dist }}/bin/yarn --daemon start nodemanager
ExecStop={{ hadoop_dist }}/bin/yarn --daemon stop nodemanager
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
